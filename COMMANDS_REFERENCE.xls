<!-- ============================================================ -->
<tr class="sectitle"><td colspan="5">القسم الأول: GIT &amp; GITHUB - أوامر الجيت وجيت هاب</td></tr>
<table>
  <tr>
    <th style="width:14%;">القسم</th>
    <th style="width:5%;">#</th>
    <th style="width:28%;">الوظيفة</th>
    <th style="width:38%;">الكود (Terminal / CMD)</th>
    <th style="width:15%;">ملاحظات</th>
  </tr>
  <tr class="rowA"><td class="sec cat-git">GitHub</td><td class="num">1</td><td>تحميل المشروع لأول مرة (HTTPS)</td><td class="code">git clone https://github.com/Fo2shh/alf_hana.git shark2</td><td>بدون مفتاح SSH</td></tr>
  <tr class="rowB"><td class="sec cat-git">GitHub</td><td class="num">2</td><td>تحميل المشروع لأول مرة (SSH)</td><td class="code">git clone git@github.com:Fo2shh/alf_hana.git shark2</td><td>تحتاج مفتاح SSH</td></tr>
  <tr class="rowA"><td class="sec cat-git">GitHub</td><td class="num">3</td><td>رفع مشروع محلي جديد على GitHub</td><td class="code">git init
git add .
git commit -m "Initial commit"
git branch -M main
git remote add origin https://github.com/Fo2shh/alf_hana.git
git push -u origin main</td><td>شغّلهم بالترتيب داخل مجلد المشروع</td></tr>
  <tr class="rowB"><td class="sec cat-git">GitHub</td><td class="num">4</td><td>جلب آخر التحديثات من GitHub</td><td class="code">git pull</td><td>أو: git pull origin main</td></tr>
  <tr class="rowA"><td class="sec cat-git">الحالة</td><td class="num">5</td><td>عرض الملفات التي تغيرت</td><td class="code">git status</td><td>قبل أي commit</td></tr>
  <tr class="rowB"><td class="sec cat-git">إضافة ملفات</td><td class="num">6</td><td>إضافة كل الملفات للـ Commit</td><td class="code">git add .</td><td>النقطة تعني "كل شيء"</td></tr>
  <tr class="rowA"><td class="sec cat-git">إضافة ملفات</td><td class="num">7</td><td>إضافة ملفات محددة فقط</td><td class="code">git add core/views.py requirements.txt</td><td>اكتب الأسماء بمسافات</td></tr>
  <tr class="rowB"><td class="sec cat-git">Commit</td><td class="num">8</td><td>حفظ التغييرات (Commit)</td><td class="code">git commit -m "Fix: solve corrupted Django install"</td><td>اكتب رسالة واضحة عربي/إنجليزي</td></tr>
  <tr class="rowA"><td class="sec cat-git">Push</td><td class="num">9</td><td>رفع للـ GitHub بعد Commit</td><td class="code">git push</td><td>بعده يظهر على GitHub فوراً</td></tr>
  <tr class="rowB"><td class="sec cat-git">فرع Branch</td><td class="num">10</td><td>إنشاء فرع جديد + الانتقال إليه</td><td class="code">git checkout -b feature/map-fix</td><td>للعمل على ميزة جديدة</td></tr>
  <tr class="rowA"><td class="sec cat-git">فرع Branch</td><td class="num">11</td><td>الانتقال لفرع موجود</td><td class="code">git checkout main</td><td>التبديل بين الفروع</td></tr>
  <tr class="rowB"><td class="sec cat-git">فرع Branch</td><td class="num">12</td><td>دمج فرع داخل الفرع الرئيسي</td><td class="code">git checkout main
git merge feature/map-fix</td><td>أولاً انتقل لـ main ثم دمج</td></tr>
  <tr class="rowA"><td class="sec cat-git">فرع Branch</td><td class="num">13</td><td>حذف فرع محلي بعد الدمج</td><td class="code">git branch -d feature/map-fix</td><td>لا تحذف قبل الدمج</td></tr>
  <tr class="rowB"><td class="sec cat-git">سجل الحفظات</td><td class="num">14</td><td>عرض سجل الـ Commits</td><td class="code">git log --oneline --graph -15</td><td>اضغط Q للخروج</td></tr>
  <tr class="rowA"><td class="sec cat-git">معلومات</td><td class="num">15</td><td>عرض رابط الريموت الحالي</td><td class="code">git remote -v</td><td>تتأكد من الرابط الصحيح</td></tr>
  <tr class="rowB"><td class="sec cat-git">تعديل</td><td class="num">16</td><td>تغيير رابط الريموت</td><td class="code">git remote set-url origin https://github.com/Fo2shh/alf_hana.git</td><td>إذا أردت تغيير الرابط</td></tr>
  <tr class="rowA"><td class="sec cat-git">إصلاح</td><td class="num">17</td><td>إلغاء تغييرات ملف (بدون commit)</td><td class="code">git checkout -- core/views.py</td><td>يرجع الملف لآخر حالة محفوظة</td></tr>
  <tr class="rowB"><td class="sec cat-git">إصلاح</td><td class="num">18</td><td>حذف آخر commit + الإبقاء على التغييرات</td><td class="code">git reset --soft HEAD~1</td><td>عدل ثم commit مرة أخرى</td></tr>
</table>

<br>
<!-- ============================================================ -->
<tr class="sectitle"><td colspan="5">القسم الثاني: VENV &amp; pip - البيئة الافتراضية وإدارة الحزم</td></tr>
<table>
  <tr>
    <th>القسم</th><th>#</th><th>الوظيفة</th><th>الكود (Terminal / CMD)</th><th>ملاحظات</th>
  </tr>
  <tr class="rowA"><td class="sec cat-venv">إنشاء</td><td class="num">1</td><td>إنشاء VENV جديد</td><td class="code">python -m venv venv</td><td>اسم المجلد venv</td></tr>
  <tr class="rowB"><td class="sec cat-venv">حذف</td><td class="num">2</td><td>حذف الـ VENV بالكامل</td><td class="code">rmdir /s /q venv</td><td><span class="note-warn">يمسح كل شيء! يمكن إعادة بنائه</span></td></tr>
  <tr class="rowA"><td class="sec cat-venv">pip</td><td class="num">3</td><td>ترقية pip داخل الـ venv</td><td class="code">venv\Scripts\python.exe -m pip install --upgrade pip</td><td><span class="note-ok">★ الأفضل دائماً بهذا الشكل</span></td></tr>
  <tr class="rowB"><td class="sec cat-venv">تنصيب</td><td class="num">4</td><td>تنصيب حزمة واحدة</td><td class="code">venv\Scripts\python.exe -m pip install django</td><td>مثال: Django</td></tr>
  <tr class="rowA"><td class="sec cat-venv">تنصيب</td><td class="num">5</td><td>تنصيب حزمة بنسخة محددة</td><td class="code">venv\Scripts\python.exe -m pip install django==5.1.7</td><td>نسخة ثابتة محددة</td></tr>
  <tr class="rowB"><td class="sec cat-venv">تنصيب</td><td class="num">6</td><td>تنصيب كل المتطلبات من الملف</td><td class="code">venv\Scripts\python.exe -m pip install -r requirements.txt</td><td>من ملف requirements.txt</td></tr>
  <tr class="rowA"><td class="sec cat-venv">إصلاح</td><td class="num">7</td><td>إعادة تنصيب نظيفة لإصلاح تلف</td><td class="code">venv\Scripts\python.exe -m pip install --no-cache-dir --force-reinstall -r requirements.txt</td><td><span class="note-ok">★★★ يصلح 90% من مشاكل Django التالفة</span></td></tr>
  <tr class="rowB"><td class="sec cat-venv">حذف حزمة</td><td class="num">8</td><td>حذف حزمة مثبتة</td><td class="code">venv\Scripts\python.exe -m pip uninstall -y django</td><td>-y = بدون سؤال تأكيد</td></tr>
  <tr class="rowA"><td class="sec cat-venv">ترقية</td><td class="num">9</td><td>ترقية حزمة موجودة لأحدث نسخة</td><td class="code">venv\Scripts\python.exe -m pip install --upgrade django</td><td>Django مثال</td></tr>
  <tr class="rowB"><td class="sec cat-venv">عرض</td><td class="num">10</td><td>عرض كل الحزم المثبتة</td><td class="code">venv\Scripts\python.exe -m pip list</td><td>ترى كل مثبت مع النسخة</td></tr>
  <tr class="rowA"><td class="sec cat-venv">عرض</td><td class="num">11</td><td>عرض تفاصيل حزمة محددة</td><td class="code">venv\Scripts\python.exe -m pip show django</td><td>الموقع + النسخة + التبعيات</td></tr>
  <tr class="rowB"><td class="sec cat-venv">تصدير</td><td class="num">12</td><td>حفظ الحزم في requirements.txt</td><td class="code">venv\Scripts\python.exe -m pip freeze > requirements.txt</td><td>بعد تنصيب حزمة جديدة</td></tr>
  <tr class="rowA"><td class="sec cat-venv">تفعيل</td><td class="num">13</td><td>تفعيل venv في CMD</td><td class="code">venv\Scripts\activate.bat</td><td>بعدها تكتب python فقط</td></tr>
  <tr class="rowB"><td class="sec cat-venv">تفعيل</td><td class="num">14</td><td>تفعيل venv في PowerShell</td><td class="code">venv\Scripts\Activate.ps1</td><td>إذا ظهر خطأ ExecutionPolicy انظر جدول الإصلاح</td></tr>
  <tr class="rowA"><td class="sec cat-venv">إيقاف</td><td class="num">15</td><td>إلغاء تفعيل الـ venv</td><td class="code">deactivate</td><td>فقط إذا كنت فعلته بالفعل</td></tr>
  <tr class="rowB"><td class="sec cat-venv">اختبار</td><td class="num">16</td><td>اختبار إن Django مثبت ويعمل</td><td class="code">venv\Scripts\python.exe -c "import django; print(django.get_version())"</td><td>تظهر رقم النسخة = نجاح</td></tr>
</table>

<br>
<!-- ============================================================ -->
<tr class="sectitle"><td colspan="5">القسم الثالث: DJANGO - أوامر manage.py</td></tr>
<table>
  <tr>
    <th>القسم</th><th>#</th><th>الوظيفة</th><th>الكود (الجزء بعد: manage.py)</th><th>ملاحظات</th>
  </tr>
  <tr><td colspan="5" style="background:#F5F5F5; color:#333; text-align:center; font-style:italic;">
    الصيغة العامة: <b><span style="direction:ltr;">venv\Scripts\python.exe manage.py ...</span></b>
  </td></tr>
  <tr class="rowA"><td class="sec cat-django">تشغيل سيرفر</td><td class="num">1</td><td>تشغيل السيرفر على المنفذ الافتراضي</td><td class="code">runserver</td><td>http://127.0.0.1:8000</td></tr>
  <tr class="rowB"><td class="sec cat-django">تشغيل سيرفر</td><td class="num">2</td><td>تشغيل على منفذ مختلف</td><td class="code">runserver 8080</td><td>أو 8001 أو أي منفذ آخر</td></tr>
  <tr class="rowA"><td class="sec cat-django">تشغيل سيرفر</td><td class="num">3</td><td>تشغيل للسيرفر للوصول من LAN</td><td class="code">runserver 0.0.0.0:8000</td><td>تقدر تفتح من كمبيوتر ثاني على الشبكة</td></tr>
  <tr class="rowB"><td class="sec cat-django">Migrations</td><td class="num">4</td><td>إنشاء ملفات الـ migrations</td><td class="code">makemigrations</td><td>بعد أي تغيير في models.py</td></tr>
  <tr class="rowA"><td class="sec cat-django">Migrations</td><td class="num">5</td><td>إنشاء migrations لـ app محدد فقط</td><td class="code">makemigrations core
makemigrations orders</td><td>أفضل وأسرع لتجنب الأخطاء</td></tr>
  <tr class="rowB"><td class="sec cat-django">Migrations</td><td class="num">6</td><td>تطبيق الـ migrations على قاعدة البيانات</td><td class="code">migrate</td><td>ينشئ الجداول في SQLite</td></tr>
  <tr class="rowA"><td class="sec cat-django">Migrations</td><td class="num">7</td><td>تطبيق migrations لـ app واحد فقط</td><td class="code">migrate core
migrate orders</td><td>التحكم الدقيق</td></tr>
  <tr class="rowB"><td class="sec cat-django">Migrations</td><td class="num">8</td><td>عرض حالة كل migrations</td><td class="code">showmigrations</td><td>[X] مطبق  [ ] غير مطبق</td></tr>
  <tr class="rowA"><td class="sec cat-django">Migrations</td><td class="num">9</td><td>طباعة SQL اللي هيشتغله migration</td><td class="code">sqlmigrate core 0001_initial</td><td>ترى الاستعلامات الحقيقية</td></tr>
  <tr class="rowB"><td class="sec cat-django">Migrations</td><td class="num">10</td><td>التراجع: مسح كل migrations لـ app</td><td class="code">migrate core zero</td><td><span class="note-warn">⚠ يمسح بيانات الـ app كلها</span></td></tr>
  <tr class="rowA"><td class="sec cat-django">ملفات ثابتة</td><td class="num">11</td><td>جمع الملفات الساكنة (CSS/JS/صور)</td><td class="code">collectstatic --noinput</td><td>ينسخهم لمجلد staticfiles/</td></tr>
  <tr class="rowB"><td class="sec cat-django">ملفات ثابتة</td><td class="num">12</td><td>مسح القديم + جمع جديد نظيف</td><td class="code">collectstatic --clear --noinput</td><td><span class="note-ok">★ الأفضل لتجنب ملفات قديمة</span></td></tr>
  <tr class="rowA"><td class="sec cat-django">مستخدمين</td><td class="num">13</td><td>إنشاء مستخدم سوبر (Admin)</td><td class="code">createsuperuser</td><td>يسألك اسم / بريد / كلمة مرور</td></tr>
  <tr class="rowB"><td class="sec cat-django">مستخدمين</td><td class="num">14</td><td>تغيير كلمة مرور مستخدم موجود</td><td class="code">changepassword admin</td><td>مثال تغيير كلمة الأدمن</td></tr>
  <tr class="rowA"><td class="sec cat-django">فحص</td><td class="num">15</td><td>فحص مشاكل المشروع الأساسية</td><td class="code">check</td><td>يتأكد أن كل شيء OK</td></tr>
  <tr class="rowB"><td class="sec cat-django">فحص</td><td class="num">16</td><td>فحص مشاكل الإنتاج (Deployment)</td><td class="code">check --deploy</td><td>تشخيص أعمق للإنتاج</td></tr>
  <tr class="rowA"><td class="sec cat-django">Shell</td><td class="num">17</td><td>فتح Django Shell تفاعلي بايثون</td><td class="code">shell</td><td>تجربة استعلامات قاعدة بيانات يدويًا، اكتب exit() للخروج</td></tr>
  <tr class="rowB"><td class="sec cat-django">اختبارات</td><td class="num">18</td><td>تشغيل كل الاختبارات</td><td class="code">test</td><td>أو test core أو test orders</td></tr>
  <tr class="rowA"><td class="sec cat-django">اختبارات</td><td class="num">19</td><td>تشغيل اختبارات بتفاصيل أكثر</td><td class="code">test -v 2</td><td>Verbose مستوى 2</td></tr>
</table>

