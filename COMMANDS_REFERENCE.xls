  .rowB           { background: #EAF2FA; }
  .cat-git        { background: #D5E8D4; color: #1C5E00; font-weight: bold; }
  .cat-venv       { background: #FFF2CC; color: #806000; font-weight: bold; }
  .cat-django     { background: #DAE8FC; color: #1B3F72; font-weight: bold; }
  .cat-scripts    { background: #F8CECC; color: #801B1B; font-weight: bold; }
  .cat-quick      { background: #E1D5E7; color: #4A236D; font-weight: bold; }
  .cat-fix        { background: #FFCC99; color: #7A3E00; font-weight: bold; }
  .cat-login      { background: #B3E5C1; color: #004208; font-weight: bold; }
  .cat-bat        { background: #BDD7EE; color: #0F3B6A; font-weight: bold; }
  .cat-structure  { background: #D0E0E3; color: #184950; font-weight: bold; }
